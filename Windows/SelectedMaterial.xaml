<Window x:Class="Lopushok.Windows.SelectedMaterial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lopushok.Windows"
        mc:Ignorable="d"
        Title="SelectedMaterial" Height="300" Width="400">
    <Grid>
        <ComboBox x:Name="MaterialComboBox" 
DisplayMemberPath="NameMaterials" 
HorizontalAlignment="Left" 
VerticalAlignment="Top" 
Width="200"   
Foreground="Black" 
Margin="10,10,0,0" 
ItemsSource="{Binding Materials}" />
        <TextBox x:Name="QuantityTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Margin="10,50,0,0" />
        <Button Content="Добавить" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Margin="10,90,0,0" Click="AddButton_Click"/>
        <Button Content="Отмена" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Margin="120,90,0,0" Click="CancelButton_Click"/>
    </Grid>
</Window>
