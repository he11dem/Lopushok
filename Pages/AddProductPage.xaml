<Page x:Class="Lopushok.Pages.AddProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lopushok.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="840" d:DesignWidth="1450"
      Title="AddProductPage">

    <Grid Background="White" Margin="10">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" >
            <!-- Артикул -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Артикул:" Width="100" VerticalAlignment="Center" FontFamily="Gabriola" />
                <TextBox x:Name="ArticleTb" Width="200" FontFamily="Gabriola" />
            </StackPanel>

            <!-- Наименование -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Наименование:" Width="100" VerticalAlignment="Center" FontFamily="Gabriola" />
                <TextBox x:Name="NameTb" Width="200" FontFamily="Gabriola" />
            </StackPanel>

            <!-- Тип продукта -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Тип продукта:" Width="100" VerticalAlignment="Center" FontFamily="Gabriola" />
                <ComboBox x:Name="TypeCb" DisplayMemberPath="NameTypeProduct" SelectedValuePath="IdTypeProduct" 
                  Width="200" Foreground="Black" ItemsSource="{Binding TypeProduct}" FontFamily="Gabriola" />
            </StackPanel>

            <!-- Изображение -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Изображение:" Width="100" VerticalAlignment="Center" FontFamily="Gabriola" />
                <Image x:Name="TestImg" Width="100" Height="100" Margin="5" />
                <Button x:Name="AddImageBtn" Content="Добавить" Width="80" Margin="5" Click="AddImageBtn_Click" FontFamily="Gabriola" />
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Button x:Name="AddProductBtn" Content="Сохранить" Width="80" Margin="5" Click="AddProductBtn_Click" FontFamily="Gabriola" />
                <Button x:Name="CancelBtn" Content="Отмена" Width="80" Margin="5" Click="CancelBtn_Click_1" FontFamily="Gabriola" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
